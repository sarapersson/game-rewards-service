# Local development example.
# These values match the Docker Compose PostgreSQL instance.
# Do not reuse local development credentials in shared or production environments.

# Shared by the API and worker processes.
APP_ENV=local
SERVICE_NAME=game-rewards-service
DATABASE_URL=postgres://game_rewards:game_rewards_dev_password@localhost:5432/game_rewards?sslmode=disable
DB_PING_TIMEOUT=2s
DB_QUERY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Shared HTTP server timeouts for the API and worker admin server.
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# API process.
HTTP_ADDR=127.0.0.1:8080

# Worker process.
WORKER_ADMIN_ADDR=127.0.0.1:8081
WORKER_POLL_INTERVAL=1s
OUTBOX_LOCK_TTL=30s
OUTBOX_PUBLISH_TIMEOUT=5s
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m
