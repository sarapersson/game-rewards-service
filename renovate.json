{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:makefileVersions",
    "security:gomodIndirectSecurityUpdates"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "ignoreUnstable": true,
  "vulnerabilityAlerts": {
    "automerge": false,
    "vulnerabilityFixStrategy": "highest"
  },
  "packageRules": [
    {
      "description": "Keep Go version and Docker builder updates atomic",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump",
      "groupName": "Go version",
      "minimumGroupSize": 2
    },
    {
      "description": "Keep Go version and Docker builder updates atomic",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "Go version",
      "minimumGroupSize": 2
    },
    {
      "description": "Keep Go module metadata tidy after dependency updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    }
  ]
}
